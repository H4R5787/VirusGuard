# =============================================================================
# VirusGuard — Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# .env is git-ignored and MUST NEVER be committed to source control.
# =============================================================================

# --- Core Security ---
# Flask session encryption key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-secure-random-32-byte-hex-key

# Set to "production" in live deployments to enforce Secure HTTPS cookies
FLASK_ENV=production

# Server Port (macOS uses 5000 for AirPlay; defaults to 5001 locally, Render passes PORT automatically)
PORT=5001

# --- Threat Intelligence & AI APIs ---
# VirusTotal API v3 key (for multi-engine file scanning): https://www.virustotal.com/
VIRUSTOTAL_API_KEY=your_virustotal_api_v3_key_here

# Groq Cloud API key (for Llama 3 70B automated threat briefings): https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Database Storage ---
# Local SQLite default: sqlite:///virus_users.db
# Render PostgreSQL: postgresql://username:password@dpg-xxxxxx.render.com/virus_users
# Local MySQL: mysql+pymysql://root:password@localhost/virus_users
DATABASE_URL=sqlite:///virus_users.db

# --- Initial Administrator Provisioning ---
# Defaults used to bootstrap the first administrator account if no admin exists
ADMIN_EMAIL=Admin@gmail.com
ADMIN_PASSWORD=change-to-a-strong-admin-password

# --- Automated Threat Intel & Advisories Ingestion Cron (Optional) ---
# Secret token to protect POST /api/sync-threat-intel & /api/sync-advisories webhooks
CRON_SECRET=generate-a-secure-random-cron-secret

# --- SOC Alert Email Notifications (Optional) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your_email_app_password
ALERT_RECIPIENT_EMAIL=security-team@yourdomain.com
