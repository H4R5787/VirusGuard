# Copy this file to .env and fill in real values. .env is git-ignored and
# should never be committed.

# --- Required ---
# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Groq API key (used for the LLM-generated threat explanations)
GROQ_API_KEY=your_groq_api_key_here

# VirusTotal API key (used to scan uploaded files)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# --- Optional (sensible defaults are used if omitted) ---
# SQLAlchemy connection string. Defaults to a local MySQL instance if unset.
DATABASE_URL=mysql+pymysql://root:root@localhost/virus_users

# Admin login. Defaults to Admin@gmail.com / admin if unset — change this in
# every real deployment. This is a stopgap; see the redesign plan's Phase 4
# for replacing it with a proper DB-backed is_admin flag.
ADMIN_EMAIL=
ADMIN_PASSWORD=
